<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="color-scheme" content="dark"><title>Greyhound Operator Console — read only</title><link rel="stylesheet" href="{{ url_for('static', filename='css/operator-ui.css') }}">{% if connected %}<script src="{{ url_for('static', filename='js/operator-ui-connected.js') }}" defer></script>{% endif %}</head>
<body data-connected="{{ 'true' if connected else 'false' }}"><a class="skip-link" href="#connected-content">Skip to connected content</a><div class="console-shell"><aside class="sidebar" aria-label="Connected read-only navigation"><div class="brand"><span class="brand__mark" aria-hidden="true">GH</span><span><strong>Greyhound</strong><small>Operator console</small></span></div><nav aria-label="Console sections"><ul class="nav-list">{% for id,label in [('overview','Dashboard'),('upcoming-races','Upcoming races'),('recent-predictions','Recent predictions'),('collector','Collector'),('corpus','Corpus'),('models','Models'),('system','System'),('audit','Audit')] %}<li><a href="#{{ id }}">{{ label }}</a></li>{% endfor %}</ul></nav><p class="sidebar__note">Authenticated Level 1 viewer. Read-only; reload to reconnect.</p></aside>
<div class="workspace"><header class="topbar"><div><p class="eyebrow">R2 · connected read models</p><h1>Operator console</h1></div><div class="persistent-labels"><strong class="mode-marker">{{ 'CONNECTED MODE' if connected else 'CONNECTED MODE OFF' }}</strong><strong class="research-warning">RESEARCH ONLY — NOT FOR BETTING</strong></div></header><main id="connected-content"><section class="hero" aria-labelledby="connected-title"><div><p class="eyebrow">Read-only evidence</p><h2 id="connected-title">Independent, source-attached operational observations</h2><p class="lede">No control, prediction launch, retry, service action, training, promotion, EV, staking, or betting action is available.</p></div><div id="connection-state" class="boundary-card" role="status" aria-live="polite"><div><strong>{{ 'Loading authenticated resources…' if connected else 'Connected mode is off' }}</strong><p>{{ 'Each resource will report independently.' if connected else 'No operational connection is installed. This page is not an operationally healthy view.' }}</p>{% if not connected %}<p><a href="{{ url_for('operator_ui_prototype') }}">Open explicitly labelled prototype</a></p>{% endif %}</div></div></section>
{% for id,label in [('overview','Dashboard / overview'),('upcoming-races','Upcoming exact races'),('recent-predictions','Recent predictions'),('collector','Collector'),('corpus','Corpus'),('models','Models'),('system','System'),('audit','Audit')] %}<section class="workflow-section" id="{{ id }}" aria-labelledby="{{ id }}-title"><div class="section-heading"><h2 id="{{ id }}-title">{{ label }}</h2></div><article class="panel resource-panel resource-panel--unavailable" data-resource="{{ id }}" aria-busy="{{ 'true' if connected else 'false' }}"><p class="resource-state status status--unavailable">{{ 'Loading…' if connected else 'UNAVAILABLE/DATA_MISSING — connected mode is not installed.' }}</p><div class="resource-data"></div><div class="resource-detail"></div></article></section>{% endfor %}<section class="workflow-section" id="detail" aria-labelledby="detail-title" hidden><div class="section-heading"><h2 id="detail-title" tabindex="-1">Exact detail</h2></div><article class="panel resource-panel resource-panel--unavailable" data-resource="detail"><p class="resource-state status status--unavailable">No detail selected.</p><div class="resource-data"></div><div class="resource-detail"></div></article></section></main><footer><strong>RESEARCH ONLY — NOT FOR BETTING</strong> · Connected Level 1 evidence is observational and read-only.</footer></div></div></body></html>
