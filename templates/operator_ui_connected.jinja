<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>Today · Greyhound</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='css/operator-ui.css', v=config.get('OPERATOR_UI_DEPLOYED_COMMIT', 'development')) }}">
  {% if connected %}
  <script src="{{ url_for('static', filename='js/operator-ui-state.js', v=config.get('OPERATOR_UI_DEPLOYED_COMMIT', 'development')) }}" defer></script>
  <script src="{{ url_for('static', filename='js/operator-ui-connected.js', v=config.get('OPERATOR_UI_DEPLOYED_COMMIT', 'development')) }}" defer></script>
  {% endif %}
</head>
<body class="race-dashboard" data-connected="{{ 'true' if connected else 'false' }}">
  <a class="skip-link" href="#connected-content">Skip to connected content</a>
  <div class="console-shell">
    <aside class="sidebar" aria-label="Connected console navigation">
      <div class="brand"><span class="brand__mark" aria-hidden="true">GH</span><span><strong>Greyhound</strong><small>Forecast console</small></span></div>
      <nav aria-label="Console sections">
        <ul class="nav-list nav-list--primary">
          <li><a href="#upcoming-races" aria-current="page">Today</a></li>
          <li><a href="/operator-ui/forecasts">Forecasts</a></li>
          <li><a href="#system-details">System</a></li>
        </ul>
      </nav>
      <p class="sidebar__note">Authenticated private console. Every prediction request is checked by the server.</p>
      <span class="sidebar__session">Private session active</span>
    </aside>

    <div class="workspace">
      <header class="topbar">
        <div><p class="eyebrow">R3 · verified forecasts</p><h1>Today</h1></div>
        <div class="persistent-labels"><strong class="mode-marker">{{ 'CONNECTED' if connected else 'CONNECTED MODE OFF' }}</strong><strong class="research-warning">RESEARCH ONLY — NOT FOR BETTING</strong></div>
      </header>

      <main id="connected-content">
        <section id="connection-state" class="today-status" role="status" aria-live="polite">
          <div class="today-status__item"><span>New predictions</span><strong>{{ 'Checking…' if connected else 'Unavailable' }}</strong></div>
          <div class="today-status__item"><span>Race inputs</span><strong>{{ 'Checking…' if connected else 'Not connected' }}</strong></div>
          <div class="today-status__item"><span>Verified history</span><strong><a href="/operator-ui/forecasts">Open forecasts</a></strong></div>
        </section>

        <section class="workflow-section" id="upcoming-races" aria-labelledby="upcoming-races-title">
          <div class="section-heading today-heading">
            <div><p class="eyebrow">Next to jump</p><h2 id="upcoming-races-title">Upcoming races</h2></div>
            <button id="refresh-upcoming" class="primary-button" type="button">Refresh display</button>
          </div>
          <div class="today-layout">
            <article class="panel resource-panel resource-panel--unavailable race-list-panel" data-resource="upcoming-races" aria-busy="{{ 'true' if connected else 'false' }}">
              <p class="resource-state status status--unavailable">{{ 'Loading…' if connected else 'UNAVAILABLE/DATA_MISSING — connected mode is not installed.' }}</p>
              <div class="resource-data"></div>
              <div class="resource-detail"></div>
            </article>

            <aside class="panel selected-race" id="selected-race" aria-labelledby="selected-race-title">
              <p class="eyebrow">Race forecast</p>
              <h2 id="selected-race-title" tabindex="-1">Select a race</h2>
              <p id="selected-race-summary" class="lede">Choose a race to inspect its runners and request a verified forecast.</p>
              <div id="selected-race-runners"></div>

              <section id="manual-prediction" aria-labelledby="manual-prediction-title" hidden>
                <h3 id="manual-prediction-title">Prediction</h3>
                <p id="prediction-readiness" role="status">Checking prediction access and fresh race inputs…</p>
                <form id="prediction-form">
                  <label class="technical-control">Exact race<select id="prediction-race" required disabled><option value="">Select an upcoming race</option></select></label>
                  <label class="technical-control">Server model<select id="prediction-model" required disabled><option value="">Load the finite model catalog first</option></select></label>
                  <label class="technical-control">Server configuration<select id="prediction-config" required disabled><option value="">No server configuration selected</option></select></label>
                  <label class="technical-control">Odds source<select id="prediction-odds" required disabled><option value="">No server odds source selected</option></select></label>
                  <p id="runner-confirmation" class="runner-confirmation">Select a race to see its runners.</p>
                  <button class="primary-button" id="prediction-submit" type="submit" disabled>Run prediction</button>
                </form>
                <div id="job-status" role="status" aria-live="polite" tabindex="-1">No job submitted in this browser.</div>
                <ol id="job-timeline" aria-label="Persisted job progress"></ol>
                <section id="job-result" aria-labelledby="job-result-title"><h3 id="job-result-title">Forecast result</h3><p>No verified forecast available for this race.</p></section>
                <details id="job-evidence"><summary>Technical forecast evidence</summary><p>Frozen model · retained pre-jump odds · sealed verification</p><div class="evidence-view">No job evidence disclosed.</div></details>
              </section>
            </aside>
          </div>
        </section>

        <section class="forecast-history-entry panel" aria-labelledby="history-entry-title">
          <div><p class="eyebrow">Available to explore</p><h2 id="history-entry-title">Understand verified forecasts</h2>
          <p>Compare each runner’s model probability with the captured market probability. Verified historical forecasts remain available when current race inputs are out of date.</p></div>
          <a class="primary-button" href="/operator-ui/forecasts">Explore forecasts</a>
        </section>

        <details class="system-details" id="system-details">
          <summary><span>System status and technical evidence</span><small>Collector, models, audit and exact identifiers</small></summary>
          <div class="system-details__content">
            {% for id,label in [('overview','Overview'),('recent-predictions','Recent predictions'),('collector','Collector'),('corpus','Corpus'),('models','Models'),('system','System'),('audit','Audit')] %}
            <section class="workflow-section" id="{{ id }}" aria-labelledby="{{ id }}-title">
              <div class="section-heading"><h2 id="{{ id }}-title">{{ label }}</h2></div>
              <article class="panel resource-panel resource-panel--unavailable" data-resource="{{ id }}" aria-busy="{{ 'true' if connected else 'false' }}">
                <p class="resource-state status status--unavailable">{{ 'Loading…' if connected else 'UNAVAILABLE/DATA_MISSING — connected mode is not installed.' }}</p>
                <div class="resource-data"></div><div class="resource-detail"></div>
              </article>
            </section>
            {% endfor %}
            <section class="workflow-section" id="detail" aria-labelledby="detail-title" hidden>
              <div class="section-heading"><h2 id="detail-title" tabindex="-1">Exact detail</h2></div>
              <article class="panel resource-panel resource-panel--unavailable" data-resource="detail"><p class="resource-state status status--unavailable">No detail selected.</p><div class="resource-data"></div><div class="resource-detail"></div></article>
            </section>
          </div>
        </details>
      </main>
      <footer><strong>RESEARCH ONLY — NOT FOR BETTING</strong><span>Probabilities appear only after strict sealed-v2 verification.</span></footer>
    </div>
  </div>
</body>
</html>
