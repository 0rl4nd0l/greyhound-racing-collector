<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="color-scheme" content="dark"><title>Greyhound Operator Console</title><link rel="stylesheet" href="{{ url_for('static', filename='css/operator-ui.css') }}">{% if connected %}<script src="{{ url_for('static', filename='js/operator-ui-state.js') }}" defer></script><script src="{{ url_for('static', filename='js/operator-ui-connected.js') }}" defer></script>{% endif %}</head>
<body data-connected="{{ 'true' if connected else 'false' }}"><a class="skip-link" href="#connected-content">Skip to connected content</a><div class="console-shell"><aside class="sidebar" aria-label="Connected console navigation"><div class="brand"><span class="brand__mark" aria-hidden="true">GH</span><span><strong>Greyhound</strong><small>Operator console</small></span></div><nav aria-label="Console sections"><ul class="nav-list">{% for id,label in [('overview','Dashboard'),('upcoming-races','Upcoming races'),('manual-prediction','Manual prediction'),('recent-predictions','Recent predictions'),('collector','Collector'),('corpus','Corpus'),('models','Models'),('system','System'),('audit','Audit')] %}<li><a href="#{{ id }}">{{ label }}</a></li>{% endfor %}</ul></nav><p class="sidebar__note">Authenticated connected console. Level 2 authority is checked by the server for every job request.</p></aside>
<div class="workspace"><header class="topbar"><div><p class="eyebrow">R3 · persisted research jobs</p><h1>Operator console</h1></div><div class="persistent-labels"><strong class="mode-marker">{{ 'CONNECTED MODE' if connected else 'CONNECTED MODE OFF' }}</strong><strong class="research-warning">RESEARCH ONLY — NOT FOR BETTING</strong></div></header><main id="connected-content"><section class="hero" aria-labelledby="connected-title"><div><p class="eyebrow">Source-attached evidence</p><h2 id="connected-title">Exact-race research prediction</h2><p class="lede">One guarded submission creates one durable job. There is no retry, race substitution, service, capture, training, promotion, staking, wagering, or betting control.</p></div><div id="connection-state" class="boundary-card" role="status" aria-live="polite"><div><strong>{{ 'Loading authenticated resources…' if connected else 'Connected mode is off' }}</strong><p>{{ 'Each resource reports independently.' if connected else 'No operational connection is installed. This is not a healthy view.' }}</p>{% if not connected %}<p><a href="{{ url_for('operator_ui_prototype') }}">Open explicitly labelled prototype</a></p>{% endif %}</div></div></section>
{% for id,label in [('overview','Dashboard / overview'),('upcoming-races','Upcoming exact races')] %}<section class="workflow-section" id="{{ id }}" aria-labelledby="{{ id }}-title"><div class="section-heading"><h2 id="{{ id }}-title">{{ label }}</h2></div><article class="panel resource-panel resource-panel--unavailable" data-resource="{{ id }}" aria-busy="{{ 'true' if connected else 'false' }}"><p class="resource-state status status--unavailable">{{ 'Loading…' if connected else 'UNAVAILABLE/DATA_MISSING — connected mode is not installed.' }}</p><div class="resource-data"></div><div class="resource-detail"></div></article></section>{% endfor %}
<section class="workflow-section" id="manual-prediction" aria-labelledby="manual-prediction-title"><div class="section-heading"><h2 id="manual-prediction-title">One exact manual research prediction</h2></div><article class="panel"><form id="prediction-form"><label>Exact race<select id="prediction-race" required disabled><option value="">Load a fresh exact race first</option></select></label><label>Server model<select id="prediction-model" required disabled><option value="">Load the finite model catalog first</option></select></label><label>Server configuration<select id="prediction-config" required disabled><option value="">No server configuration selected</option></select></label><label>Odds source<select id="prediction-odds" required disabled><option value="">No server odds source selected</option></select></label><p id="runner-confirmation" class="missing-value">No exact ordered runner set selected.</p><button class="primary-button" id="prediction-submit" type="submit" disabled>Submit one durable job</button></form><div id="job-status" role="status" aria-live="polite" tabindex="-1">No job submitted in this browser.</div><ol id="job-timeline" aria-label="Persisted job progress"></ol><section id="job-result" aria-labelledby="job-result-title"><h3 id="job-result-title">Verified terminal result or blocker</h3><p>No terminal evidence disclosed.</p></section><details id="job-evidence"><summary>Job evidence</summary><div class="evidence-view">No job evidence disclosed.</div></details></article></section>
{% for id,label in [('recent-predictions','Recent predictions'),('collector','Collector'),('corpus','Corpus'),('models','Models'),('system','System'),('audit','Audit')] %}<section class="workflow-section" id="{{ id }}" aria-labelledby="{{ id }}-title"><div class="section-heading"><h2 id="{{ id }}-title">{{ label }}</h2></div><article class="panel resource-panel resource-panel--unavailable" data-resource="{{ id }}" aria-busy="{{ 'true' if connected else 'false' }}"><p class="resource-state status status--unavailable">{{ 'Loading…' if connected else 'UNAVAILABLE/DATA_MISSING — connected mode is not installed.' }}</p><div class="resource-data"></div><div class="resource-detail"></div></article></section>{% endfor %}<section class="workflow-section" id="detail" aria-labelledby="detail-title" hidden><div class="section-heading"><h2 id="detail-title" tabindex="-1">Exact detail</h2></div><article class="panel resource-panel resource-panel--unavailable" data-resource="detail"><p class="resource-state status status--unavailable">No detail selected.</p><div class="resource-data"></div><div class="resource-detail"></div></article></section></main><footer><strong>RESEARCH ONLY — NOT FOR BETTING</strong> · Probabilities appear only after strict sealed-v2 verification.</footer></div></div></body></html>
