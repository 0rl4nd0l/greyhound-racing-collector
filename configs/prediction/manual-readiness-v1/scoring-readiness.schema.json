{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greyhound-racing-collector.invalid/schemas/manual-readiness-v1/scoring-readiness.schema.json",
  "title": "manual scoring readiness index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "safety", "generated_at", "source_refresh_report", "repository", "readiness_authoritative", "model", "config", "scoring_contract", "ghu_050_056", "selected_race_count", "eligible_race_count", "excluded_race_count", "races", "exclusions"],
  "properties": {
    "schema_version": {"const": "manual_prediction_scoring_readiness_index_v1"},
    "safety": {"$ref": "#/$defs/safety"},
    "generated_at": {"$ref": "#/$defs/timestamp"},
    "source_refresh_report": {"$ref": "#/$defs/source"},
    "repository": {"type": "object", "additionalProperties": false, "required": ["commit", "tree"], "properties": {"commit": {"$ref": "#/$defs/git"}, "tree": {"$ref": "#/$defs/git"}}},
    "readiness_authoritative": {"type": "object", "additionalProperties": false, "required": ["members"], "properties": {"members": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file_identity"}}}},
    "model": {"type": "object", "additionalProperties": false, "required": ["model_id", "model_sha256", "manifest_sha256", "effective_state_schema", "effective_state_sha256"], "properties": {"model_id": {"const": "market_form_residual_v1"}, "model_sha256": {"$ref": "#/$defs/sha256"}, "manifest_sha256": {"$ref": "#/$defs/sha256"}, "effective_state_schema": {"const": "market_form_residual_effective_state_v2"}, "effective_state_sha256": {"$ref": "#/$defs/sha256"}}},
    "config": {"type": "object", "additionalProperties": false, "required": ["manual_capture", "prediction", "minimum_prejump_margin_seconds"], "properties": {"manual_capture": {"$ref": "#/$defs/config_ref"}, "prediction": {"$ref": "#/$defs/config_ref"}, "minimum_prejump_margin_seconds": {"type": "integer", "minimum": 1}}},
    "scoring_contract": {"type": "object", "additionalProperties": false, "required": ["schema_version", "sha256", "numeric_canonicalization_sha256"], "properties": {"schema_version": {"const": "market_form_residual_scoring_config_v1"}, "sha256": {"$ref": "#/$defs/sha256"}, "numeric_canonicalization_sha256": {"$ref": "#/$defs/sha256"}}},
    "ghu_050_056": {"type": "object", "additionalProperties": false, "minProperties": 7, "maxProperties": 7, "patternProperties": {"^GHU-05[0-6]$": {"$ref": "#/$defs/lane_identity"}}},
    "selected_race_count": {"type": "integer", "minimum": 0},
    "eligible_race_count": {"type": "integer", "minimum": 0},
    "excluded_race_count": {"type": "integer", "minimum": 0},
    "races": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/race"}},
    "exclusions": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/exclusion"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "safety": {"type": "object", "additionalProperties": false, "required": ["research_only", "canonical", "phase7_excluded", "phase7_eligible", "phase7_exclusion_reason"], "properties": {"research_only": {"const": true}, "canonical": {"const": false}, "phase7_excluded": {"const": true}, "phase7_eligible": {"const": false}, "phase7_exclusion_reason": {"const": "manual_research_only_noncanonical"}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256", "generated_at", "status"], "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "generated_at": {"$ref": "#/$defs/timestamp"}, "status": {"enum": ["SUCCESS", "METADATA_COVERAGE_INCOMPLETE"]}}},
    "config_ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "lane_identity": {"type": "object", "additionalProperties": false, "required": ["merge_commit", "members"], "properties": {"merge_commit": {"$ref": "#/$defs/git"}, "members": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}}}},
    "file_identity": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "race": {"type": "object", "additionalProperties": false, "required": ["url", "race_id", "race_date", "venue", "venue_slug", "race_number", "scheduled_start", "race_identity_sha256", "runner_set_sha256", "runners", "form_source", "prejump", "odds"], "properties": {"url": {"type": "string", "minLength": 1}, "race_id": {"type": "string", "minLength": 1}, "race_date": {"type": "string", "format": "date"}, "venue": {"type": "string", "minLength": 1}, "venue_slug": {"type": "string", "minLength": 1}, "race_number": {"type": "integer", "minimum": 1}, "scheduled_start": {"$ref": "#/$defs/timestamp"}, "race_identity_sha256": {"$ref": "#/$defs/sha256"}, "runner_set_sha256": {"$ref": "#/$defs/sha256"}, "runners": {"type": "array", "minItems": 2, "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["runner_id", "box_number", "dog_name", "source_native_runner_id"], "properties": {"runner_id": {"type": "string", "minLength": 1}, "box_number": {"type": "integer", "minimum": 1, "maximum": 10}, "dog_name": {"type": "string", "minLength": 1}, "source_native_runner_id": {"type": ["string", "null"]}}}}, "form_source": {"type": "object", "additionalProperties": false, "required": ["source_url", "observed_at", "source_generated_at", "csv_path", "csv_sha256", "sidecar_path", "sidecar_sha256"], "properties": {"source_url": {"type": "string", "minLength": 1}, "observed_at": {"$ref": "#/$defs/timestamp"}, "source_generated_at": {"$ref": "#/$defs/timestamp"}, "csv_path": {"type": "string", "minLength": 1}, "csv_sha256": {"$ref": "#/$defs/sha256"}, "sidecar_path": {"type": "string", "minLength": 1}, "sidecar_sha256": {"$ref": "#/$defs/sha256"}}}, "prejump": {"type": "object", "additionalProperties": false, "required": ["source_generated_at", "observed_at", "minimum_margin_seconds"], "properties": {"source_generated_at": {"$ref": "#/$defs/timestamp"}, "observed_at": {"$ref": "#/$defs/timestamp"}, "minimum_margin_seconds": {"type": "integer", "minimum": 1}}}, "odds": {"type": "object", "additionalProperties": false, "required": ["status", "next_authorized_step"], "properties": {"status": {"const": "PENDING_GHU_051"}, "next_authorized_step": {"const": "GHU-051_ONE_RACE_BOUNDED_CAPTURE"}}}}
    },
    "exclusion": {"type": "object", "additionalProperties": false, "required": ["selected_index", "race_id", "race_url", "reason_code", "detail"], "properties": {"selected_index": {"type": "integer", "minimum": 0}, "race_id": {"type": ["string", "null"]}, "race_url": {"type": ["string", "null"]}, "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}, "detail": {"type": ["string", "null"]}}}
  }
}
