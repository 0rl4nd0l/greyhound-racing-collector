{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greyhound-racing-collector.invalid/schemas/manual-independent-capture-v1/evidence-manifest.schema.json",
  "title": "manual independent evidence manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "bundle_id", "safety", "publication_protocol", "members"],
  "properties": {
    "schema_version": {"const": "manual_independent_evidence_manifest_v1"},
    "contract_version": {"const": "manual-independent-capture-v1"},
    "bundle_id": {"$ref": "#/$defs/sha256"},
    "safety": {"$ref": "#/$defs/safety"},
    "publication_protocol": {"const": "same_filesystem_fsync_atomic_directory_rename_v1"},
    "members": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/bundle_member"},
        {"$ref": "#/$defs/odds_member"},
        {"$ref": "#/$defs/terminal_member"},
        {"$ref": "#/$defs/source_member"}
      ],
      "items": false
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research_only", "canonical", "phase7_excluded", "phase7_eligible", "phase7_exclusion_reason"],
      "properties": {
        "research_only": {"const": true},
        "canonical": {"const": false},
        "phase7_excluded": {"const": true},
        "phase7_eligible": {"const": false},
        "phase7_exclusion_reason": {"const": "manual_research_only_noncanonical"}
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "bundle_member": {"allOf": [{"$ref": "#/$defs/member"}, {"properties": {"path": {"const": "bundle.json"}}}]},
    "odds_member": {"allOf": [{"$ref": "#/$defs/member"}, {"properties": {"path": {"const": "normalized/odds.json"}}}]},
    "terminal_member": {"allOf": [{"$ref": "#/$defs/member"}, {"properties": {"path": {"const": "producer/terminal.json"}}}]},
    "source_member": {"allOf": [{"$ref": "#/$defs/member"}, {"properties": {"path": {"const": "source/raw.bin"}}}]}
  }
}
