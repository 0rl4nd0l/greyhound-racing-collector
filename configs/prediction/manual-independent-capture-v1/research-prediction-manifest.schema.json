{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greyhound-racing-collector.invalid/schemas/manual-independent-capture-v1/research-prediction-manifest.schema.json",
  "title": "manual research prediction manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "safety", "bundle_id", "publication_protocol", "members"],
  "properties": {
    "schema_version": {"const": "manual_research_prediction_manifest_v1"},
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": ["research_only", "canonical", "phase7_excluded", "phase7_eligible", "phase7_exclusion_reason"],
      "properties": {
        "research_only": {"const": true}, "canonical": {"const": false},
        "phase7_excluded": {"const": true}, "phase7_eligible": {"const": false},
        "phase7_exclusion_reason": {"const": "manual_research_only_noncanonical"}
      }
    },
    "bundle_id": {"$ref": "#/$defs/sha256"},
    "publication_protocol": {"const": "same_filesystem_fsync_atomic_directory_rename_v1"},
    "members": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"const": "prediction.json"},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
