{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greyhound-racing-collector.invalid/schemas/manual-independent-capture-v1/research-prediction.schema.json",
  "title": "manual research prediction v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "safety", "scorer_id", "race", "race_identity_sha256", "runner_set_sha256", "timing", "evidence", "form", "features", "model", "config", "scoring_parity", "implementation", "ranking", "predictions"],
  "properties": {
    "schema_version": {"const": "manual_research_prediction_v1"},
    "bundle_id": {"$ref": "#/$defs/sha256"},
    "safety": {"$ref": "#/$defs/safety"},
    "scorer_id": {"const": "manual_research_market_form_residual_v1"},
    "race": {"$ref": "#/$defs/race"},
    "race_identity_sha256": {"$ref": "#/$defs/sha256"},
    "runner_set_sha256": {"$ref": "#/$defs/sha256"},
    "timing": {
      "type": "object", "additionalProperties": false,
      "required": ["sealed_cutoff_timestamp", "odds_capture_timestamp", "source_timestamp", "scheduled_start"],
      "properties": {
        "sealed_cutoff_timestamp": {"$ref": "#/$defs/timestamp"},
        "odds_capture_timestamp": {"$ref": "#/$defs/timestamp"},
        "source_timestamp": {"$ref": "#/$defs/timestamp"},
        "scheduled_start": {"$ref": "#/$defs/timestamp"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["bundle_id", "manifest_sha256", "odds_sha256"],
      "properties": {
        "bundle_id": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "odds_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "form": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "sha256", "feature_sha256"],
      "properties": {
        "schema_version": {"const": "manual_research_embedded_form_v1"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "feature_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "features": {"$ref": "#/$defs/features"},
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "model_sha256", "manifest_sha256", "effective_state_schema", "effective_state_sha256"],
      "properties": {
        "model_id": {"const": "market_form_residual_v1"},
        "model_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "effective_state_schema": {"type": "string", "minLength": 1},
        "effective_state_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "config": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "sha256"],
      "properties": {
        "schema_version": {"const": "manual_research_scoring_config_v1"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "scoring_parity": {
      "type": "object", "additionalProperties": false,
      "required": ["input_schema_version", "input_sha256", "core_output_schema_version", "core_output_sha256", "config_sha256", "numeric_canonicalization_sha256"],
      "properties": {
        "input_schema_version": {"const": "market_form_residual_scoring_input_v1"},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "core_output_schema_version": {"const": "market_form_residual_scoring_core_output_v1"},
        "core_output_sha256": {"$ref": "#/$defs/sha256"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "numeric_canonicalization_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "implementation": {"$ref": "#/$defs/implementation"},
    "ranking": {
      "type": "object", "additionalProperties": false,
      "required": ["primary_probability", "tie_break"],
      "properties": {
        "primary_probability": {"const": "full_probability"},
        "tie_break": {"const": "box_ascending"}
      }
    },
    "predictions": {
      "type": "array", "minItems": 2, "maxItems": 10,
      "items": {"$ref": "#/$defs/prediction"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_object": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$"},
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": ["research_only", "canonical", "phase7_excluded", "phase7_eligible", "phase7_exclusion_reason"],
      "properties": {
        "research_only": {"const": true}, "canonical": {"const": false},
        "phase7_excluded": {"const": true}, "phase7_eligible": {"const": false},
        "phase7_exclusion_reason": {"const": "manual_research_only_noncanonical"}
      }
    },
    "race": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "race_id", "race_date", "venue", "venue_slug", "race_number", "scheduled_start"],
      "properties": {
        "url": {"type": "string", "minLength": 1}, "race_id": {"type": "string", "minLength": 1},
        "race_date": {"type": "string", "format": "date"}, "venue": {"type": "string", "minLength": 1},
        "venue_slug": {"type": "string", "minLength": 1}, "race_number": {"type": "integer", "minimum": 1},
        "scheduled_start": {"$ref": "#/$defs/timestamp"}
      }
    },
    "implementation": {
      "type": "object", "additionalProperties": false,
      "required": ["source_commit", "source_tree", "feature_adapter_sha256", "scorer_sha256", "embedded_form_schema_sha256", "prediction_schema_sha256", "prediction_manifest_schema_sha256"],
      "properties": {
        "source_commit": {"$ref": "#/$defs/git_object"}, "source_tree": {"$ref": "#/$defs/git_object"},
        "feature_adapter_sha256": {"$ref": "#/$defs/sha256"}, "scorer_sha256": {"$ref": "#/$defs/sha256"},
        "embedded_form_schema_sha256": {"$ref": "#/$defs/sha256"}, "prediction_schema_sha256": {"$ref": "#/$defs/sha256"},
        "prediction_manifest_schema_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "feature_value": {"type": ["number", "null"]},
    "feature_values": {
      "type": "object", "additionalProperties": false,
      "required": ["prior_start_count", "days_since_last_start", "recent_finish_mean_3", "recent_finish_best_5", "recent_win_rate_5", "recent_place_rate_5", "recent_avg_margin_5", "career_win_rate", "career_place_rate", "career_avg_finish", "starts_same_venue", "win_rate_same_venue", "starts_same_distance", "win_rate_same_distance", "same_grade_start_count", "same_grade_win_rate"],
      "properties": {
        "prior_start_count": {"$ref": "#/$defs/feature_value"}, "days_since_last_start": {"$ref": "#/$defs/feature_value"},
        "recent_finish_mean_3": {"$ref": "#/$defs/feature_value"}, "recent_finish_best_5": {"$ref": "#/$defs/feature_value"},
        "recent_win_rate_5": {"$ref": "#/$defs/feature_value"}, "recent_place_rate_5": {"$ref": "#/$defs/feature_value"},
        "recent_avg_margin_5": {"$ref": "#/$defs/feature_value"}, "career_win_rate": {"$ref": "#/$defs/feature_value"},
        "career_place_rate": {"$ref": "#/$defs/feature_value"}, "career_avg_finish": {"$ref": "#/$defs/feature_value"},
        "starts_same_venue": {"$ref": "#/$defs/feature_value"}, "win_rate_same_venue": {"$ref": "#/$defs/feature_value"},
        "starts_same_distance": {"$ref": "#/$defs/feature_value"}, "win_rate_same_distance": {"$ref": "#/$defs/feature_value"},
        "same_grade_start_count": {"$ref": "#/$defs/feature_value"}, "same_grade_win_rate": {"$ref": "#/$defs/feature_value"}
      }
    },
    "feature_row": {
      "type": "object", "additionalProperties": false,
      "required": ["runner_id", "box_number", "display_name", "values"],
      "properties": {
        "runner_id": {"type": "string", "minLength": 1}, "box_number": {"type": "integer", "minimum": 1, "maximum": 10},
        "display_name": {"type": "string", "minLength": 1}, "values": {"$ref": "#/$defs/feature_values"}
      }
    },
    "features": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "adapter_version", "adapter_sha256", "form_sha256", "cutoff_timestamp", "target", "sha256", "runners"],
      "properties": {
        "schema_version": {"const": "manual_research_feature_rows_v1"},
        "adapter_version": {"const": "manual_research_embedded_form_features_v1"},
        "adapter_sha256": {"$ref": "#/$defs/sha256"}, "form_sha256": {"$ref": "#/$defs/sha256"},
        "cutoff_timestamp": {"$ref": "#/$defs/timestamp"}, "target": {"type": "object"},
        "sha256": {"$ref": "#/$defs/sha256"}, "runners": {"type": "array", "minItems": 2, "maxItems": 10, "items": {"$ref": "#/$defs/feature_row"}}
      }
    },
    "probability": {"type": "number", "minimum": 0, "maximum": 1},
    "prediction": {
      "type": "object", "additionalProperties": false,
      "required": ["runner_id", "box_number", "display_name", "strict_win_odds", "market_probability", "half_probability", "full_probability", "features", "rank"],
      "properties": {
        "runner_id": {"type": "string", "minLength": 1}, "box_number": {"type": "integer", "minimum": 1, "maximum": 10},
        "display_name": {"type": "string", "minLength": 1}, "strict_win_odds": {"type": "number", "exclusiveMinimum": 1},
        "market_probability": {"$ref": "#/$defs/probability"}, "half_probability": {"$ref": "#/$defs/probability"},
        "full_probability": {"$ref": "#/$defs/probability"}, "features": {"$ref": "#/$defs/feature_values"},
        "rank": {"type": "integer", "minimum": 1}
      }
    }
  }
}
