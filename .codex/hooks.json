{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/skills/tenn-git-guard/scripts/tenn_git_guard.py\" hook --repo-root \"$(git rev-parse --show-toplevel)\" --platform codex --event BeforeTool",
            "statusMessage": "Checking Greyhound V2 tool authority..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/skills/tenn-git-guard/scripts/tenn_git_guard.py\" hook --repo-root \"$(git rev-parse --show-toplevel)\" --platform codex --event Stop",
            "statusMessage": "Checking Greyhound V2 task outcome..."
          }
        ]
      }
    ]
  }
}
