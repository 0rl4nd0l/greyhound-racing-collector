[Unit]
Description=One fixed private speed comparison after authorised result closure

[Service]
Type=oneshot
UMask=0077
WorkingDirectory=@SOURCE@
Nice=15
CPUQuota=25%
MemoryMax=512M
TasksMax=32
IOSchedulingClass=idle
TimeoutStartSec=10min
KillMode=control-group
ExecStart=/usr/bin/bwrap --die-with-parent --unshare-net --ro-bind / / --bind @EVALUATION_STATE@ @EVALUATION_STATE@ --tmpfs /tmp --proc /proc --dev /dev --setenv PYTHONDONTWRITEBYTECODE 1 --setenv OPENBLAS_NUM_THREADS 1 --setenv OMP_NUM_THREADS 1 @PYTHON@ -B -m scripts.run_prospective_speed evaluate --job @JOB@ --job-sha256 @JOB_SHA256@ --output @EVALUATION_STATE@
